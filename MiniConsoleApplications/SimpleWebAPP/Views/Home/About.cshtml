@{
    ViewData["Title"] = "About Tap Tap";
}

<!-- Hero Section -->
<section class="bg-primary text-white text-center py-5">
    <div class="container">
        <h1 class="display-4 fw-bold">About</h1>
        <p class="lead mt-3">
            Empowering Future Software Engineers Through Practical Learning
        </p>
    </div>
</section>

<!-- About Company -->
<section class="container py-5">
    <div class="row align-items-center">

        <div class="col-lg-6">
            <img src="~/images/TAP.png"
     class="img-fluid rounded shadow"
     alt="Tap Training Center">
        </div>

        <div class="col-lg-6">
            <h2 class="fw-bold text-primary">Who We Are</h2>

            <p class="mt-3">
                <strong>Tap</strong>, an initiative by
                <strong>Transflower Private Limited</strong>,
                is a professional software training platform dedicated to
                transforming students into industry-ready software developers.
            </p>

            <p>
                Our mission is to bridge the gap between academic knowledge and
                real-world software development by providing practical,
                project-based learning under experienced mentors.
            </p>
        </div>

    </div>
</section>

<!-- Courses -->
<section class="bg-light py-5">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="fw-bold">Courses We Offer</h2>
            <p>Learn the latest technologies used by top IT companies.</p>
        </div>

        <div class="row g-4">

            <div class="col-md-3">
                <div class="card shadow h-100 text-center">
                    <div class="card-body">
                        <h4>☕ Full Stack Java</h4>
                        <p>
                            Master Java, Spring Boot, Hibernate,
                            REST APIs, MySQL, HTML, CSS,
                            JavaScript and React.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow h-100 text-center">
                    <div class="card-body">
                        <h4>💜 .NET Full Stack</h4>
                        <p>
                            Learn C#, ASP.NET Core MVC,
                            Web API, Entity Framework,
                            SQL Server and Angular.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow h-100 text-center">
                    <div class="card-body">
                        <h4>🐍 Python Full Stack</h4>
                        <p>
                            Build applications using Python,
                            Django, Flask, REST APIs,
                            HTML, CSS and JavaScript.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow h-100 text-center">
                    <div class="card-body">
                        <h4>📱 Emerging Technologies</h4>
                        <p>
                            Learn cloud computing,
                            AI fundamentals, Git,
                            DevOps and modern software tools.
                        </p>
                    </div>
                </div>
            </div>

        </div>

    </div>
</section>

<!-- Why Choose -->
<section class="container py-5">

    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">Why Learn With Tap Tap?</h2>
    </div>

    <div class="row">

        <div class="col-md-6">
            <ul class="list-group list-group-flush">
                <li class="list-group-item">✔ Industry-focused curriculum</li>
                <li class="list-group-item">✔ Experienced software professionals</li>
                <li class="list-group-item">✔ Hands-on coding sessions</li>
                <li class="list-group-item">✔ Live project development</li>
                <li class="list-group-item">✔ Team collaboration using Git & GitHub</li>
            </ul>
        </div>

        <div class="col-md-6">
            <ul class="list-group list-group-flush">
                <li class="list-group-item">✔ Internship-oriented training</li>
                <li class="list-group-item">✔ Code reviews by mentors</li>
                <li class="list-group-item">✔ Real-world software development practices</li>
                <li class="list-group-item">✔ Resume & interview preparation</li>
                <li class="list-group-item">✔ Placement guidance</li>
            </ul>
        </div>

    </div>

</section>

<!-- Experience Section -->
<section class="bg-dark text-white py-5">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">
                <h2 class="fw-bold">
                    Real World Experience
                </h2>

                <p class="mt-3">
                    At Tap Tap, learning goes beyond theory.
                    Students actively participate in real-world software projects,
                    collaborate with teammates, use professional development tools,
                    and follow industry-standard workflows.
                </p>

                <p>
                    This practical experience builds confidence and prepares learners
                    for internships and software engineering careers.
                </p>
            </div>

            <div class="col-lg-6">
                <img src="~/images/project-team.jpg"
                     class="img-fluid rounded shadow"
                     alt="Students Working">
            </div>

        </div>

    </div>

</section>

<!-- Statistics -->
<section class="container py-5">

    <div class="row text-center">

        <div class="col-md-3">
            <h1 class="text-primary">500+</h1>
            <h5>Students Trained</h5>
        </div>

        <div class="col-md-3">
            <h1 class="text-primary">20+</h1>
            <h5>Industry Mentors</h5>
        </div>

        <div class="col-md-3">
            <h1 class="text-primary">50+</h1>
            <h5>Live Projects</h5>
        </div>

        <div class="col-md-3">
            <h1 class="text-primary">100%</h1>
            <h5>Practical Learning</h5>
        </div>

    </div>

</section>

<!-- Call to Action -->
<section class="bg-primary text-white text-center py-5">

    <div class="container">

        <h2>Start Your Journey With Tap Tap</h2>

        <p class="lead mt-3">
            Learn • Build • Innovate • Grow
        </p>

        <a href="/Home/Contact" class="btn btn-light btn-lg mt-3">
            Contact Us
        </a>

    </div>

</section>