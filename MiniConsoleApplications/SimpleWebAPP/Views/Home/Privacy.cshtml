@{
    ViewData["Title"] = "Privacy Policy";
}
45
<!-- Header -->
<section class="bg-primary text-white py-5">
    <div class="container text-center">
        <h1 class="display-3 fw-bold">Privacy Policy</h1>
        <p class="lead">
            Your privacy matters. We are committed to protecting your personal information.
        </p>
    </div>
</section>

<!-- Main Content -->
<div class="container my-5">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-body p-5">

            <div class="text-center mb-5">
                <h2 class="fw-bold text-primary">
                    Welcome to Tap Tap
                </h2>

                <p class="text-muted fs-5">
                    An initiative by <strong>Transflower Private Limited</strong>
                </p>
            </div>

            <!-- Commitment -->
            <div class="p-4 bg-light rounded-4 mb-4">
                <h3 class="text-primary">🛡️ Our Commitment</h3>
                <p class="mt-3">
                    We respect your privacy and are committed to safeguarding
                    the personal information you share with us. Your trust is
                    important, and we ensure your data is handled securely and responsibly.
                </p>
            </div>

            <!-- Information -->
            <div class="row g-4">

                <div class="col-md-6">

                    <div class="card h-100 shadow-sm border-primary">

                        <div class="card-body">

                            <h4 class="text-primary">
                                📋 Information We Collect
                            </h4>

                            <ul class="mt-3">
                                <li>Personal Details</li>
                                <li>Email Address</li>
                                <li>Phone Number</li>
                                <li>Course Preferences</li>
                                <li>Educational Information</li>
                                <li>Feedback & Suggestions</li>
                            </ul>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="card h-100 shadow-sm border-success">

                        <div class="card-body">

                            <h4 class="text-success">
                                ⚙️ How We Use Your Information
                            </h4>

                            <ul class="mt-3">
                                <li>Course Registration</li>
                                <li>Student Support</li>
                                <li>Training Updates</li>
                                <li>Improve Learning Experience</li>
                                <li>Website Security</li>
                                <li>Communication</li>
                            </ul>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Data Security -->
            <div class="mt-5 p-4 border-start border-5 border-primary bg-light rounded">

                <h3 class="text-primary">
                    🔒 Data Security
                </h3>

                <p class="mt-3">
                    We implement appropriate technical and organizational
                    security measures to protect your personal information
                    from unauthorized access, alteration, disclosure, or destruction.
                </p>

            </div>

            <!-- Cookies -->
            <div class="mt-4 p-4 border-start border-5 border-warning bg-light rounded">

                <h3 class="text-warning">
                    🍪 Cookies
                </h3>

                <p class="mt-3">
                    Cookies help us improve website performance, remember
                    your preferences, and provide a better browsing experience.
                </p>

            </div>

            <!-- Rights -->
            <div class="mt-4">

                <h3 class="text-primary text-center mb-4">
                    Your Rights
                </h3>

                <div class="row text-center">

                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 p-3">
                            <h1>👁️</h1>
                            <h5>Access</h5>
                            <p>View your information.</p>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 p-3">
                            <h1>✏️</h1>
                            <h5>Update</h5>
                            <p>Correct your details.</p>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 p-3">
                            <h1>🗑️</h1>
                            <h5>Delete</h5>
                            <p>Request data removal.</p>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 p-3">
                            <h1>📞</h1>
                            <h5>Contact</h5>
                            <p>Reach us anytime.</p>
                        </div>
                    </div>

                </div>

            </div>

            <!-- Contact -->
            <div class="mt-5 bg-primary text-white rounded-4 p-5 text-center">

                <h2>Need Help?</h2>

                <p class="mt-3">
                    If you have any questions regarding this Privacy Policy,
                    please feel free to contact the Tap Tap team.
                </p>

                <hr class="bg-white">

                <p class="mb-2">
                    📧 support@transflower.in
                </p>

                <p class="mb-2">
                    📞 +91 XXXXX XXXXX
                </p>

                <p class="mb-0">
                    📍 Pune, Maharashtra, India
                </p>

            </div>

        </div>

    </div>

</div>

<!-- Footer -->
<section class="bg-dark text-white text-center py-4">

    <div class="container">

        <h4 class="fw-bold">
            Tap Tap - Transflower Private Limited
        </h4>

        <p class="mb-0">
            Empowering Students Through Practical Learning & Real-World Experience.
        </p>

    </div>

</section>