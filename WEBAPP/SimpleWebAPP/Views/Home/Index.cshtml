@{
    ViewData["Title"] = "Home Page";
}
@* @{
    ViewData["Title"] = "Home";
} *@

<!-- Hero Section -->
<section class="bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <h1 class="display-4 fw-bold">
                    Welcome to Tap Tap
                </h1>

                <h3 class="mt-3">
                    Powered by Transflower Private Limited
                </h3>

                <p class="lead mt-4">
                    Learn Full Stack Java, .NET, Python, Web Development,
                    Cloud Technologies and gain hands-on experience by
                    working on real-world software projects.
                </p>

                <a href="/Home/About" class="btn btn-light btn-lg me-3">
                    Learn More
                </a>

                <a href="/Home/Contact" class="btn btn-outline-light btn-lg">
                    Contact Us
                </a>
            </div>

            <div class="col-lg-6 text-center">
                <img src="~/images/TAP.png"
                     class="img-fluid rounded shadow"
                     alt="Tap Tap">
            </div>

        </div>
    </div>
</section>

<!-- About -->
<section class="container py-5">

    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">Who We Are</h2>
    </div>

    <div class="row align-items-center">

        <div class="col-lg-6">
            <img src="~/images/TAP.png"
                 class="img-fluid rounded shadow">
        </div>

        <div class="col-lg-6">

            <p class="fs-5">
                Tap Tap is a professional learning platform by
                <strong>Transflower Private Limited</strong>.
            </p>

            <p>
                We help students become industry-ready software developers
                through practical training, coding sessions,
                internships and live projects.
            </p>

            <p>
                Our mission is to bridge the gap between academics
                and industry by providing hands-on learning.
            </p>

        </div>

    </div>

</section>

<!-- Courses -->
<section class="bg-light py-5">

    <div class="container">

        <div class="text-center mb-5">
            <h2 class="fw-bold">Our Popular Courses</h2>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="card shadow h-100">

                    <img src="~/images/java.jpg"
                         class="card-img-top">

                    <div class="card-body text-center">

                        <h4>☕ Full Stack Java</h4>

                        <p>
                            Java • Spring Boot • Hibernate • React • MySQL
                        </p>

                    </div>

                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow h-100">

                    <img src="~/images/dotnet.jpg"
                         class="card-img-top">

                    <div class="card-body text-center">

                        <h4>💜 .NET Full Stack</h4>

                        <p>
                            C# • ASP.NET Core MVC • SQL Server • Angular
                        </p>

                    </div>

                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow h-100">

                    <img src="~/images/python.jpg"
                         class="card-img-top">

                    <div class="card-body text-center">

                        <h4>🐍 Python Full Stack</h4>

                        <p>
                            Python • Django • Flask • React
                        </p>

                    </div>

                </div>
            </div>

        </div>

    </div>

</section>

